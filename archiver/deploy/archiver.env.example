# /etc/openNASR/archiver.env  (mode 600, owned by the opennasr user)
OPENNASR_S3_ENDPOINT_URL=https://s3.xds-lab.com
OPENNASR_S3_REGION=garage
OPENNASR_S3_BUCKET=opennasr
OPENNASR_S3_ADDRESSING_STYLE=path
OPENNASR_ARCHIVER_S3_ACCESS_KEY_ID=
OPENNASR_ARCHIVER_S3_SECRET_ACCESS_KEY=
# Optional: Slack-compatible webhook for alerts (fired once, resolved once).
OPENNASR_ALERT_WEBHOOK_URL=
