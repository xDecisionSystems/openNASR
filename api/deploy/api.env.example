# /etc/openNASR/api.env  (mode 600, owned by the opennasr user)
# Comma-separated API keys. Make one per client:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OPENNASR_API_KEYS=
OPENNASR_API_HOST=0.0.0.0
OPENNASR_API_PORT=8000
# Requests per minute per key (0 turns limiting off).
OPENNASR_API_RATE_PER_MINUTE=120

# Where to fetch validated cycles from. This key is read-only.
OPENNASR_S3_ENDPOINT_URL=https://s3.xds-lab.com
OPENNASR_S3_REGION=garage
OPENNASR_S3_BUCKET=opennasr
OPENNASR_S3_ADDRESSING_STYLE=path
OPENNASR_API_S3_ACCESS_KEY_ID=
OPENNASR_API_S3_SECRET_ACCESS_KEY=
