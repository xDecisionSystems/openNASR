#!/usr/bin/env python3
"""Install a signed openNASR GitHub release into an existing systemd deployment."""

import argparse
from contextlib import contextmanager
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import time
from urllib.request import urlopen

REPOSITORY = "xDecisionSystems/openNASR"
GITHUB = f"https://github.com/{REPOSITORY}"
ISSUER = "https://token.actions.githubusercontent.com"
APP = Path("/opt/openNASR")
UNIT_ROOT = Path("/etc/systemd/system")
DUCKDB_VERSION_FILE = Path("/etc/openNASR/duckdb-version")
TAG_PATTERN = re.compile(r"v[0-9]+(?:\.[0-9]+){2}(?:[a-z0-9.+-]+)?")


def download(url, destination):
    with urlopen(url, timeout=30) as response, destination.open("wb") as output:
        shutil.copyfileobj(response, output)


def digest(path):
    checksum = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            checksum.update(chunk)
    return checksum.hexdigest()


def verified_installation(tag, role, directory):
    base = f"{GITHUB}/releases/download/{tag}"
    manifest = directory / "manifest.json"
    bundle = directory / "manifest.json.sigstore.json"
    for path in (manifest, bundle):
        download(f"{base}/{path.name}", path)
    subprocess.run(
        [
            "cosign",
            "verify-blob",
            "--bundle",
            str(bundle),
            "--certificate-identity",
            f"{GITHUB}/.github/workflows/release.yml@refs/tags/{tag}",
            "--certificate-oidc-issuer",
            ISSUER,
            str(manifest),
        ],
        check=True,
    )
    data = json.loads(manifest.read_bytes())
    if (data["version"], data["repository"]) != (tag, REPOSITORY):
        raise ValueError("Manifest repository or tag does not match")
    schema = data["schema"]
    legacy = schema == 1 and tag == "v2.0.0"
    if schema != 2 and not legacy:
        raise ValueError(f"Unsupported deployment manifest schema {schema}")
    assets = data["assets"]

    def fetch_verified(name):
        expected = assets.get(name)
        if expected is None:
            raise ValueError(f"Missing {name} in the signed manifest")
        path = directory / name
        download(f"{base}/{name}", path)
        if digest(path) != expected:
            raise ValueError(f"SHA-256 mismatch for {name}")
        return path

    lock = None if legacy else fetch_verified(f"{role}-dependencies.txt")
    requirements = []
    for name, extras in (
        ("opennasr", ""),
        ("opennasr_contract", "[s3]"),
        (f"opennasr_{role}", "[s3]" if role == "archiver" else ""),
    ):
        matches = [
            asset
            for asset in assets
            if re.fullmatch(rf"{name}-[A-Za-z0-9_.+-]+-py3-none-any\.whl", asset)
        ]
        if len(matches) != 1:
            raise ValueError(
                f"Expected exactly one platform-independent wheel for {name}"
            )
        wheel = fetch_verified(matches[0])
        requirements.append(f"{name}{extras} @ {wheel.as_uri()}")
    return requirements, lock


def systemctl(*args):
    subprocess.run(["systemctl", *args], check=True)


def install(tag, role):
    duckdb = DUCKDB_VERSION_FILE.read_text().strip()
    releases = APP / "releases"
    releases.mkdir(exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="opennasr-assets-") as temporary:
        requirements, lock = verified_installation(tag, role, Path(temporary))
        target = Path(tempfile.mkdtemp(prefix=f"{role}-{tag}-", dir=releases))
        try:
            subprocess.run([sys.executable, "-m", "venv", str(target)], check=True)
            python = target / "bin/python"
            pip = [python, "-m", "pip", "install"]
            if lock is None:
                print(f"{tag} does not contain a dependency lock", file=sys.stderr)
            else:
                subprocess.run(
                    [
                        *pip,
                        "--no-deps",
                        "--only-binary=:all:",
                        "--require-hashes",
                        "-r",
                        lock,
                    ],
                    check=True,
                )
                pip += ["--no-deps", "--only-binary=:all:"]
            subprocess.run(
                [*pip, f"duckdb=={duckdb}", *requirements],
                check=True,
            )
            subprocess.run([python, "-m", "pip", "check"], check=True)
            subprocess.run(
                [
                    python,
                    "-c",
                    "import duckdb; c = duckdb.connect(); "
                    "assert c.execute('select 1').fetchone() == (1,)",
                ],
                check=True,
            )
            executable = target / f"bin/openNASR-{role}"
            subprocess.run(
                [executable, "--help"], check=True, stdout=subprocess.DEVNULL
            )
            # mkdtemp starts at 0700. Let the service account read the verified venv.
            target.chmod(0o755)
            if role == "archiver":
                probe_archiver(executable)
        except Exception:
            shutil.rmtree(target)
            raise
    return executable


def read_override(path):
    return path.read_text(encoding="utf-8") if path.exists() else ""


def write_state(path, content):
    if content is None:
        path.unlink(missing_ok=True)
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        dir=path.parent, mode="w", encoding="utf-8", delete=False
    ) as handle:
        temporary = Path(handle.name)
        try:
            with handle:
                handle.write(content)
            temporary.chmod(0o644)
            temporary.replace(path)
        finally:
            temporary.unlink(missing_ok=True)


def activate(role, unit, ready_url):
    systemctl("daemon-reload")
    if role == "archiver":
        # The existing timer starts the new executable on its next run.
        return
    systemctl("restart", unit)
    deadline = time.monotonic() + 180
    while time.monotonic() < deadline:
        try:
            with urlopen(ready_url, timeout=5) as response:
                if json.load(response).get("status") == "ready":
                    return
        except (OSError, ValueError):
            pass
        time.sleep(2)
    raise RuntimeError(f"API readiness check failed at {ready_url}")


def probe_archiver(executable):
    subprocess.run(
        [
            "systemd-run",
            "--wait",
            "--collect",
            "--pipe",
            "--quiet",
            "--property=Type=oneshot",
            "--property=TimeoutStartSec=45s",
            "--property=User=opennasr",
            "--property=Group=opennasr",
            "--property=EnvironmentFile=/etc/openNASR/archiver.env",
            executable,
            "status",
        ],
        check=True,
    )


def switch(role, unit, ready_url, override, previous, replacement):
    old = read_override(override)
    try:
        write_state(override, replacement or None)
        activate(role, unit, ready_url)
        # Empty content records the original ExecStart for a first-install rollback.
        write_state(previous, old)
    except (Exception, KeyboardInterrupt):
        write_state(override, old or None)
        activate(role, unit, ready_url)
        raise


def service_property(unit, name):
    return subprocess.check_output(
        ["systemctl", "show", unit, f"--property={name}", "--value"], text=True
    ).strip()


def prune_releases(role, unit, override, previous):
    """Remove superseded updater venvs after a successful switch."""
    if role == "archiver" and service_property(unit, "ActiveState") not in (
        "inactive",
        "failed",
    ):
        print("Archiver is running; leaving old releases on disk")
        return

    releases = APP / "releases"
    if not releases.is_dir() or releases.is_symlink():
        return

    commands = []
    for state in (read_override(override), previous.read_text(encoding="utf-8")):
        if state:
            command = re.search(r"^ExecStart=(/\S+)(?:[ \t]+run)?$", state, re.M)
            if command is None:
                return
            commands.append(command[1])

    # Include the effective command in case systemd has other drop-ins.
    effective = re.findall(r"\bpath=(/[^ ;]+)", service_property(unit, "ExecStart"))
    if not effective:
        return
    commands.extend(effective)
    protected = {Path(command).parent.parent.resolve() for command in commands}

    for path in sorted(releases.iterdir()):
        tag, separator, suffix = path.name.removeprefix(f"{role}-").rpartition("-")
        if (
            not path.name.startswith(f"{role}-")
            or not separator
            or not TAG_PATTERN.fullmatch(tag)
            or not re.fullmatch(r"[a-z0-9_]{8}", suffix)
            or path.is_symlink()
            or path.resolve() in protected
            or not (path / "pyvenv.cfg").is_file()
            or not (path / f"bin/openNASR-{role}").is_file()
        ):
            continue
        shutil.rmtree(path)
        print(f"Removed superseded release {path.name}")


@contextmanager
def update_lock():
    with (APP / ".update.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        yield


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--role", required=True, choices=("api", "archiver"))
    operation = parser.add_mutually_exclusive_group(required=True)
    operation.add_argument("--version", metavar="TAG")
    operation.add_argument("--rollback", action="store_true")
    parser.add_argument("--ready-url", default="http://127.0.0.1:8000/ready")
    args = parser.parse_args()
    if os.geteuid() != 0:
        parser.error("run as root")
    if args.version and not TAG_PATTERN.fullmatch(args.version):
        parser.error("--version requires a release tag such as v2.0.0")

    role = args.role
    unit = f"openNASR-{role}.service"
    override = UNIT_ROOT / f"{unit}.d/50-signed-release.conf"
    previous = APP / f"{role}.previous-exec-start"
    with update_lock():
        subprocess.run(
            ["systemctl", "cat", unit], check=True, stdout=subprocess.DEVNULL
        )
        if args.rollback:
            replacement = previous.read_text(encoding="utf-8")
        else:
            marker = f"# openNASR release {args.version}\n"
            if read_override(override).startswith(marker):
                print(f"{role} is already configured for {args.version}")
                return
            executable = install(args.version, role)
            command = f"{executable} run" if role == "archiver" else str(executable)
            replacement = f"{marker}[Service]\nExecStart=\nExecStart={command}\n"
        switch(role, unit, args.ready_url, override, previous, replacement)
        try:
            prune_releases(role, unit, override, previous)
        except (OSError, subprocess.CalledProcessError) as error:
            print(f"Could not finish pruning old releases: {error}", file=sys.stderr)
    print(f"{role} {'rolled back' if args.rollback else f'updated to {args.version}'}")


if __name__ == "__main__":
    try:
        main()
    except (
        KeyError,
        OSError,
        ValueError,
        RuntimeError,
        subprocess.CalledProcessError,
    ) as error:
        sys.exit(f"openNASR update failed: {error}")
